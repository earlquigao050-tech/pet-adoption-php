NODE_ENV=development
HOST=0.0.0.0
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pet_adoption
DB_USER=root
DB_PASSWORD=

# Public URL used by Android and by pet image links in the API responses.
PUBLIC_API_URL=http://localhost:3000

# Comma-separated browser website origins. Leave * only while developing locally.
CORS_ORIGIN=*

# Optional alternative folder for pet image uploads.
# UPLOAD_DIR=
